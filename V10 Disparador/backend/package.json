{
  "name": "gerenciador-disparadores-v10-backend",
  "version": "10.0.0",
  "private": true,
  "description": "Backend modular com SQLite, fila, CRM, simulação e Cloud API para a V10",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
